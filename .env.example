# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Postgres (Django's own database) ---
POSTGRES_DB=phishsim
POSTGRES_USER=phishsim
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- MySQL (Gophish's own database) ---
MYSQL_DATABASE=gophish
MYSQL_USER=gophish
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_HOST=mysql
MYSQL_PORT=3306

# --- Redis (Celery broker) ---
REDIS_URL=redis://redis:6379/0

# --- Gophish ---
# API key is generated by Gophish on first boot; copy it here once available so Django's
# PhishingEngineClient can authenticate. Never commit a real value.
GOPHISH_API_URL=http://gophish:3333
GOPHISH_API_KEY=change-me-after-first-boot
# Shared secret for verifying X-Gophish-Signature on inbound webhooks.
GOPHISH_WEBHOOK_SECRET=change-me
# Name of the Gophish sending profile (SMTP config) used to launch campaigns —
# Phase 1 assumes one org-wide sending profile; must exist in Gophish already.
GOPHISH_DEFAULT_SEND_PROFILE=default

# --- Email (training reminders) ---
# Leave unset for local dev/test — defaults to the console backend (prints to
# stdout/log, no real SMTP needed). Override both for a real deployment.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=noreply@example.com

# --- Campaign launch rate limiting (Phase 3) ---
# Max campaign launches per rolling 24h, across both the admin action and
# the scheduler. Applies org-wide, not per-user.
CAMPAIGN_LAUNCH_RATE_LIMIT=5

# Production only (DJANGO_SETTINGS_MODULE=config.settings.prod)
# DJANGO_SECURE_HSTS_SECONDS=31536000   # enable once HTTPS is confirmed end to end
# DJANGO_BEHIND_TLS_PROXY=true          # only if a TLS-terminating proxy sets X-Forwarded-Proto

# Days an employee has to finish an assigned training module (drives the overdue metric)
TRAINING_DUE_DAYS=14

# Launched campaigns are re-checked against Gophish (missed-webhook fallback) for this many days
RECONCILE_WINDOW_DAYS=30

# --- Network (docker-compose.yml) ---
# Only change these if 172.28.0.0/24 collides with a network on the host. The Gophish IP must be inside
# the subnet but OUTSIDE the dynamic range, so no other container can be given it.
# INTERNAL_SUBNET=172.28.0.0/24
# INTERNAL_DYNAMIC_RANGE=172.28.0.128/25
# GOPHISH_INTERNAL_IP=172.28.0.10
